# ignored without hiding source packages such as verl/verl/models or config/model.
/model/
/models/
/OPD-main/model/
/Math/OPD-main/model/
checkpoints/
OPD-main/datasets/mbpp_opd/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

