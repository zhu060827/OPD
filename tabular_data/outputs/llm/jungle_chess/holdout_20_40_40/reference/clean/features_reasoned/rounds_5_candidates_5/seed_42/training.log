      u1 = df['white_piece0_strength'] - df['black_piece0_strength']
      u2 = np.sign(u1)
      u3 = df['white_piece0_strength'] - df['black_piece0_strength']
      u4 = np.abs(u3)
      u5 = np.log1p(u4)
      u6 = u2 * u5
      新列 = u6；所有输入逐行计算，统计参数仅在训练集计算一次。
